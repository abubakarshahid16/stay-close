{
  "expo": {
    "name": "Stay Close",
    "slug": "stay-close",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stayclose.app",
      "infoPlist": {
        "NSContactsUsageDescription": "Stay Close uses your contacts so you can choose the people you want to stay connected with. Your contacts never leave your device."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.stayclose.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "scheme": "stay-close",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Stay Close uses your contacts so you can choose the people you want to stay connected with. Your contacts never leave your device."
        }
      ],
      "./plugins/withMinimalPermissions"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/stay-close"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Stay Close",
      "shortName": "Stay Close",
      "description": "A private, offline relationship reminder. No account, no cloud.",
      "themeColor": "#1c1c1c",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
